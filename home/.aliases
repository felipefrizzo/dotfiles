# Aliases

alias st='open -a SourceTree'

# IP Addresses
alias ip="dig +short myip.opendns.com @resolver1.opendns.com"
alias localip="ipconfig getifaddr en0"
alias ips="ifconfig -a | grep -o 'inet6\? \(addr:\)\?\s\?\(\(\([0-9]\+\.\)\{3\}[0-9]\+\)\|[a-fA-F0-9:]\+\)' | awk '{ sub(/inet6? (addr:)? ?/, \"\"); print }'"

# Terragrunt
alias tg="terragrunt"

# Bat
alias bat="cat"

# Eza
alias ls='eza --icons --color=auto --group-directories-first'
alias ll='eza -l --icons --color=auto --group-directories-first'
alias la='eza -la --icons --color=auto --group-directories-first'

ai-memory-up() {
  docker compose -f "${AI_MEMORY_HOME:?}/docker-compose.yml" --project-directory "$AI_MEMORY_HOME" up -d
}
ai-memory-down() {
  docker compose -f "${AI_MEMORY_HOME:?}/docker-compose.yml" --project-directory "$AI_MEMORY_HOME" down
}
ai-memory-logs() {
  docker compose -f "${AI_MEMORY_HOME:?}/docker-compose.yml" --project-directory "$AI_MEMORY_HOME" logs -f "$@"
}
ai-memory-restart() {
  docker compose -f "${AI_MEMORY_HOME:?}/docker-compose.yml" --project-directory "$AI_MEMORY_HOME" up -d --force-recreate
}
