[user]
	name = Felipe Frizzo
	email = felipefrizzo@gmail.com
[credential]
	helper = osxkeychain
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager
[color]
	diff = auto
	status = auto
	branch = auto
	interactive = auto
[merge]
	summary = true
[core]
	excludesfile = /Users/felipefrizzo/.gitignore_global
	editor = code -n -w
[push]
	default = current
[alias]
	st=status
	co=checkout
	br=branch
	rb=rebase
	mg=merge
	cm=commit -a --amend -C HEAD
	ci=commit -a -v -m
	pu=push
	pl=pull
	branches=branch -a
	remotes=remote -v
	prunetags=fetch --prune origin '+refs/tags/*:refs/tags/*'
[diff]
	renames = copies
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[include]
	path = ~/.gitconfig-confidentials
[init]
	defaultBranch = main
[pull]
	rebase = true
[commit]
	template = /Users/felipefrizzo/.stCommitMsg

[url "git@github.com:"]
    insteadOf = https://github.com/
[credential "https://jaxf-github.fanatics.corp"]
	provider = github
[credential "https://dev.azure.com"]
	useHttpPath = true
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
